{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "preview:scheduled": "opennextjs-cloudflare build && opennextjs-cloudflare preview --test-scheduled",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:schema:local": "wrangler d1 execute at-meshcore --file=./migrations/0001_meshcore_repeaters.sql --local",
    "db:count:local": "wrangler d1 execute at-meshcore --command=\"SELECT COUNT(*) AS count FROM meshcore_repeaters\" --local",
    "start": "next start",
    "lint": "pnpm -w biome lint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@opennextjs/cloudflare": "1.19.10",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-presence": "^1.1.5",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@remixicon/react": "^4.6.0",
    "@turf/bbox-polygon": "^7.3.5",
    "@turf/boolean-intersects": "^7.3.5",
    "@turf/boolean-point-in-polygon": "^7.3.5",
    "@types/mdx": "^2.0.13",
    "@workspace/map": "workspace:*",
    "@workspace/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "^16.6.3",
    "fumadocs-mdx": "^14.2.7",
    "fumadocs-ui": "^16.6.3",
    "kysely": "^0.28.8",
    "kysely-d1": "^0.4.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.6",
    "next-intl": "4.12.0",
    "next-themes": "0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "scroll-into-view-if-needed": "^3.1.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260518.1",
    "@content-collections/core": "^0.14.3",
    "@content-collections/mdx": "^0.2.2",
    "@content-collections/next": "^0.2.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^5.9.3",
    "wrangler": "4.92.0"
  }
}
